#!/bin/sh
# Dont edit this file, it is generated by goh
if command -v goh >/dev/null 2>&1; then
    exec goh hook {{hook-name}} "$@"
fi
for dir in "${CARGO_HOME:-$HOME/.cargo}/bin" "$HOME/.cargo/bin"; do
    dir=$(printf '%s' "$dir" | tr '\\' '/')
    for name in goh goh.exe; do
        if [ -x "$dir/$name" ]; then
            exec "$dir/$name" hook {{hook-name}} "$@"
        fi
    done
done
echo "[goh] goh not found: add the cargo bin directory to PATH" >&2
exit 127
