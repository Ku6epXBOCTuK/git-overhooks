#!/bin/sh
# Dont edit this file, it is generated by goh
# Auto-formatter: npm/pnpm/yarn/bun run format, cargo fmt.
# If a formatter changed unstaged files, the commit is aborted.

set -u

before_file=$(mktemp)
after_file=$(mktemp)
trap 'rm -f "$before_file" "$after_file"' EXIT

snapshot() {
    git diff > "$1"
}

check_changes() {
    snapshot "$after_file"
    if ! cmp -s "$before_file" "$after_file"; then
        echo "[goh] formatting applied - unstaged changes appeared."
        echo "[goh] Commit aborted. Review changes (git diff), stage them and commit again."
        exit 1
    fi
}

run_formatter() {
    # $1 - display name, rest - command
    name=$1
    shift
    echo "[goh] running $name ..."
    "$@" || exit 1
    check_changes
}

snapshot "$before_file"

# Node.js
if [ -f package.json ] && grep -Eq '"format"[[:space:]]*:' package.json; then
    if [ -f pnpm-lock.yaml ]; then
        run_formatter "pnpm format" pnpm format
    elif [ -f yarn.lock ]; then
        run_formatter "yarn format" yarn format
    elif [ -f bun.lockb ] || [ -f bun.lock ]; then
        run_formatter "bun run format" bun run format
    else
        run_formatter "npm run format" npm run format
    fi
fi

# Rust
if [ -f Cargo.toml ]; then
    run_formatter "cargo fmt" cargo fmt
fi

exit 0
